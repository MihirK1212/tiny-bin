HOST=127.0.0.1
PORT=8000
NUM_WORKERS=1
DB_USER=<dbuser>
DB_PASSWORD=<dbpassword>
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=<dbname>

# dev postgres passwords:
# 1. {user: postgres, password: postgres}
# 2. {user: tinybin, password: tinybin_password, dbname: tinybin}

# HOST
# local (non-docker) -> HOST=127.0.0.1 listens on loopback only
# docker -> use HOST=0.0.0.0 so the container accepts connections from the host and other containers

# DB_HOST
# local (non-docker) -> DB_HOST=127.0.0.1 (or localhost) for Postgres on the same machine.
# docker -> use the Postgres container name on your network, e.g. DB_HOST=postgres-service
